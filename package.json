{
  "name": "clipforge",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build:web": "tsc && vite build",
    "check:i18n": "node scripts/check-i18n-keys.mjs && node scripts/scan-hardcoded-copy.mjs",
    "check:i18n-runtime": "node scripts/verify-i18n-runtime.mjs",
    "test:unit": "node scripts/run-unit-checks.mjs && node scripts/verify-editor-agent-bridge.mjs && node scripts/verify-settings-surface.mjs && node scripts/verify-onboarding-surface.mjs && node scripts/verify-runtime-boundaries.mjs && node scripts/verify-hot-path.mjs && node scripts/verify-mcp-dispatch.mjs && node scripts/verify-file-size.mjs && node scripts/verify-surface-boundaries.mjs",
    "test:interaction": "bash scripts/run-interaction-tests.sh",
    "test:agent": "node scripts/verify-agent-panel.mjs",
    "test:boundaries": "node scripts/verify-hot-path.mjs && node scripts/verify-runtime-boundaries.mjs && node scripts/verify-file-size.mjs && node scripts/verify-surface-boundaries.mjs",
    "test:perf": "node scripts/perf-smoke.mjs",
    "build:manual": "node scripts/generate-release-manual.mjs",
    "build": "bash ./scripts/build-mac-release.sh",
    "build:mac-release": "bash ./scripts/build-mac-release.sh",
    "motion:studio": "pnpm --filter @clipforge/remotion-workbench studio",
    "motion:still": "pnpm --filter @clipforge/remotion-workbench still",
    "motion:render:intro": "pnpm --filter @clipforge/remotion-workbench render:intro",
    "motion:render:onboarding": "pnpm --filter @clipforge/remotion-workbench render:onboarding",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@floating-ui/react": "^0.27.20",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-hover-card": "^1.1.18",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@shadcn/react": "^0.2.1",
    "@tanstack/react-router": "^1.170.17",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.28.1",
    "radix-ui": "^1.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "description": "<p align=\"center\">   <img src=\"assets/brand/clipforge-banner.png\" width=\"760\" alt=\"ClipForge banner\" /> </p>",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/embaobao/clipforge.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/embaobao/clipforge/issues"
  },
  "homepage": "https://github.com/embaobao/clipforge#readme"
}
